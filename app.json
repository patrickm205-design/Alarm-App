{
  "expo": {
    "name": "Social Alarm",
    "slug": "social-alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.socialalarm.app"
    },
    "android": {
      "package": "com.socialalarm.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ]
    ]
  }
}
